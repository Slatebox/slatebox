{
  "name": "slatebox",
  "version": "0.2.1",
  "description": "Run your own Slatebox with one command: npx slatebox install. Gives it a free team address (https://<name>.slatebox.team) with no DNS, ports or certificates, or uses your own domain; installs on Docker here, a server over SSH, Kubernetes, or writes the files. Also runs agent scripts against any Slatebox (slatebox exec).",
  "keywords": [
    "slatebox",
    "self-host",
    "installer",
    "docker",
    "kubernetes",
    "helm",
    "whiteboard",
    "open-source"
  ],
  "homepage": "https://docs.slatebox.com/installation/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slatebox/slatebox.git",
    "directory": "packages/slatebox"
  },
  "bugs": {
    "url": "https://github.com/Slatebox/slatebox/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "slatebox": "bin/slatebox.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.mjs",
    "prepublishOnly": "SLATEBOX_PUBLISH=1 npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "slatebox-mcp": "0.4.1"
  }
}
