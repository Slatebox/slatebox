<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by the slatebox installer: automatic updates of a Slatebox on this Mac (every five minutes). -->
<plist version="1.0">
  <dict>
    <key>Label</key><string>com.slatebox.slatebox.updater</string>
    <key>ProgramArguments</key>
    <array><string>/bin/sh</string><string>/Users/me/.slatebox/installs/slatebox/updater.sh</string></array>
    <key>StartInterval</key><integer>300</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>/Users/me/.slatebox/installs/slatebox/updates/updater.log</string>
    <key>StandardErrorPath</key><string>/Users/me/.slatebox/installs/slatebox/updates/updater.log</string>
  </dict>
</plist>
