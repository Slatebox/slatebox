{
  "name": "slatebox-mcp",
  "version": "0.3.5",
  "mcpName": "com.slatebox/slatebox",
  "description": "Slatebox is an open source visual intelligence platform where you can invite any AI via MCP to collaborate with you and your team.",
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "mind-map",
    "mindmap",
    "diagram",
    "flowchart",
    "whiteboard",
    "project-planning",
    "gantt",
    "timeline",
    "presentation",
    "mermaid",
    "collaboration",
    "open-source",
    "miro-alternative"
  ],
  "homepage": "https://docs.slatebox.com/developers/slateboxapi/mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slatebox/slatebox.git",
    "directory": "packages/slatebox-mcp"
  },
  "bugs": {
    "url": "https://github.com/Slatebox/slatebox/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "slatebox-mcp": "src/cli.js",
    "slatebox": "src/slatebox.js"
  },
  "exports": {
    "./client": {
      "types": "./generated/slatebox.d.ts",
      "default": "./src/client/index.js"
    },
    "./exec": "./src/exec/index.js"
  },
  "files": [
    "src",
    "generated",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
