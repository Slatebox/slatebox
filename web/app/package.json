  "scripts": {
    "prestart": "node ../../scripts/enterprise-stage.mjs link",
    "start": "concurrently \"testim connect\" \"stripe listen --forward-to http://localhost:3000/stripehooks\" \"meteor run --settings ./settings.dev.json\"",
    "startMin": "concurrently \"testim connect\" \"stripe listen --forward-to http://localhost:3000/stripehooks\" \"meteor run --production --settings ./settings.dev.json\"",
    "startProd": "concurrently \"testim connect\" \"stripe listen --forward-to http://localhost:3000/stripehooks\" \"meteor run --settings ./settings.prod.json\"",
    "visualize": "meteor --production --extra-packages bundle-visualizer",
    "install-fpr": "rm -fr ./node_modules/font-picker-react && npm install font-picker-react && rimraf ./node_modules/font-picker-react/node_modules/react ./node_modules/font-picker-react/node_modules/react-dom",
    "test:image-palette": "node scripts/test-image-palette.mjs",
    "test:dependency-contracts": "node scripts/test-dependency-contracts.mjs",
    "test:guest-registration": "node scripts/test-guest-registration.mjs",
    "test:presentation-fallback": "node scripts/test-presentation-fallback.mjs",
    "test:welcome-template-routing": "node scripts/test-welcome-template-routing.mjs",
    "test:procon-template-seed": "node scripts/test-procon-template-seed.mjs",
    "test:deepinfra-provider": "node scripts/test-deepinfra-provider.mjs",
    "test:initial-prompt": "node scripts/test-initial-prompt.mjs",
    "eval:deepinfra-layout": "node scripts/eval-deepinfra-layout.mjs",
    "eval:deepinfra-presentation": "node scripts/eval-deepinfra-presentation.mjs",
    "eval:deepinfra-welcome": "node scripts/eval-deepinfra-welcome.mjs",
    "eval:deepinfra-slate-route": "node scripts/eval-deepinfra-slate-route.mjs",
