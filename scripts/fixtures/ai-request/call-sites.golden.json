  "draft:lanes": {
    "request": {
      "feature": "workshop",
      "prompts": [
        {
          "role": "user",
          "content": "Choose a venue for the spring party with the team"
        }
      ],
      "system": "Design an interactive decision workshop tailored to this brief. Choose 2–5 meaningful lanes and 4–10 short, concrete, editable cards. Use lowercase hyphenated IDs. Express a real constraint when useful, e.g. a shortlist capacity. Do not exceed initial capacities. Every allowedLaneIds list must include the starting lane. If the brief describes what happens with and without a card in a lane, capture both messages in a signal using those exact card and lane IDs. Preserve any outcome name and quoted messages supplied in the brief. Return one draft_workshop tool call. Use plain text. Use only the supplied brief and do not invent confidential facts.",
      "functions": [
        {
          "name": "draft_workshop",
          "description": "Design a decision workshop with movable cards, named lanes, and optional limits.",
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "title",
              "lanes",
              "cards"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "lanes": {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "capacity": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 24
                    }
                  }
                }
              },
              "signals": {
                "type": "array",
                "maxItems": 24,
                "description": "A visible change caused by placing one specific card in one lane. Include outcomes the brief asks the team to observe.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label",
                    "cardId",
                    "laneId",
                    "whenPresent",
                    "whenAbsent"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "cardId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "laneId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "whenPresent": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "whenAbsent": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  }
                }
              },
              "cards": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label",
                    "laneId"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "laneId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "allowedLaneIds": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 5,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "function_call": {
        "name": "draft_workshop"
      },
      "maxResponseValidationRetries": 1
    },
    "retries": [
      {
        "code": "invalidWorkshopDraft",
        "retryPrompt": "Return a complete draft_workshop tool call. Include version 1, a title, 2–5 lanes with unique IDs and labels, and cards with unique IDs, labels and an existing laneId. Omit optional properties entirely when unused. Each signal needs a unique ID, an existing card and lane, and two nonempty outcome messages. Each lane capacity must fit its starting cards. Each allowedLaneIds array must include its card’s starting lane."
      },
      {
        "code": "invalidWorkshopDraft",
        "retryPrompt": "Return a complete draft_workshop tool call. Include version 1, a title, 2–5 lanes with unique IDs and labels, and cards with unique IDs, labels and an existing laneId. Omit optional properties entirely when unused. Each signal needs a unique ID, an existing card and lane, and two nonempty outcome messages. Each lane capacity must fit its starting cards. Each allowedLaneIds array must include its card’s starting lane."
      }
    ]
  },
  "draft:map": {
    "request": {
      "feature": "workshop",
      "prompts": [
        {
          "role": "user",
          "content": "Choose a venue for the spring party with the team"
        }
      ],
      "system": "Build a playable concept map tailored to the supplied situation. Use the draft_concept_map tool. Use two to five stations total. Use four when the brief leaves the size open. Give each station a distinctive short name and a concrete consequence. Use those station names exactly in next and start. Model different choices when the brief asks for them. Start the token at a station with an onward path. Every station must be reachable from that starting station. If the brief names a change that depends on the token being at one station, include a signal with both the present and absent messages. Preserve any outcome name and quoted messages supplied in the brief. Return only the requested tool arguments.",
      "functions": [
        {
          "name": "draft_concept_map",
          "description": "Create an editable simulation of a decision. Name each station, the consequence of arriving there, and the stations it leads to.",
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "stations",
              "token",
              "start"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "stations": {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "outcome",
                    "next"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "outcome": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "next": {
                      "type": "array",
                      "maxItems": 4,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "description": "Exact names of other stations reachable from here. An empty array ends the path."
                    }
                  }
                }
              },
              "signals": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "station",
                    "whenPresent",
                    "whenAbsent"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "description": "Name of the outcome. Preserve the name given in the brief."
                    },
                    "station": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "description": "Exact target station name."
                    },
                    "whenPresent": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "whenAbsent": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  }
                }
              },
              "token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Name the person or object moving through the map."
              },
              "start": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Exact name of the station where the token begins. It must lead to another station."
              }
            }
          }
        }
      ],
      "function_call": {
        "name": "draft_concept_map"
      },
      "maxResponseValidationRetries": 1
    },
    "retries": [
      {
        "code": "invalidConceptMapDraft",
        "retryPrompt": "Build a playable concept map tailored to the supplied situation. Use the draft_concept_map tool. Use two to five stations total. Use four when the brief leaves the size open. Give each station a distinctive short name and a concrete consequence. Use those station names exactly in next and start. Model different choices when the brief asks for them. Start the token at a station with an onward path. Every station must be reachable from that starting station. If the brief names a change that depends on the token being at one station, include a signal with both the present and absent messages. Preserve any outcome name and quoted messages supplied in the brief. Return only the requested tool arguments. Repair the previous draft. Call the requested tool."
      },
      {
        "code": "invalidConceptMapDraft",
        "retryPrompt": "Build a playable concept map tailored to the supplied situation. Use the draft_concept_map tool. Use two to five stations total. Use four when the brief leaves the size open. Give each station a distinctive short name and a concrete consequence. Use those station names exactly in next and start. Model different choices when the brief asks for them. Start the token at a station with an onward path. Every station must be reachable from that starting station. If the brief names a change that depends on the token being at one station, include a signal with both the present and absent messages. Preserve any outcome name and quoted messages supplied in the brief. Return only the requested tool arguments. Repair the previous draft. Call the requested tool."
      }
    ]
