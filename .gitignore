node_modules
.DS_STORE
.history
.ssl-cert
.env
.env.*
!.env.example

# Meteor settings hold real keys: never commit them. Copy
# web/app/settings.example.json to web/app/settings.dev.json for a local run.
settings*
!settings.example.json
# the one-container image's settings module is code, not settings: it must be committed, or a
# fresh checkout builds an image that cannot configure itself (self-host/tests/tracked.test.mjs)
!/self-host/rootfs/opt/slatebox/lib/settings.mjs
!.vscode/settings.json
# The installer's settings modules are code, not Meteor settings (no keys in them).
!/packages/slatebox/src/ai/settings-adapter.mjs
!/packages/slatebox/src/render/settings.mjs

# Slatebox Cloud's legal documents are added to the hosted build from private
# storage at ship time; they are not part of the public repository.
web/app/public/slatebox_terms_of_use.pdf
web/app/public/slatebox_privacy_policy.pdf

# Where the app loads Slatebox Cloud's enterprise/ code from: a development link, a Cloud build's
# copy or a self-host build's stub (scripts/enterprise-stage.mjs). Never committed.
/web/app/enterprise

# Private notes and data exports
internal/

testim-headless.zip
/test-results/
/playwright-report/
/playwright/.cache/
email-previews/
